[Unit]
Description=SAFSPP Django portal (Gunicorn)
After=network.target postgresql.service
Requires=postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=safspp
Group=safspp
WorkingDirectory=/opt/safspp/source/portal
EnvironmentFile=/etc/safspp/portal.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/safspp/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8001 --workers 2 --worker-tmp-dir /run/safspp --timeout 45 --graceful-timeout 30 --max-requests 1000 --max-requests-jitter 100 --error-logfile - --log-level warning
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0027
RuntimeDirectory=safspp
RuntimeDirectoryMode=0750
StateDirectory=safspp
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/safspp /var/lib/safspp
TasksMax=64
LimitNOFILE=4096
MemoryHigh=650M
MemoryMax=900M
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
