# Supply a randomly generated secret outside the repository, minimum 50 characters.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# For a localhost SSH tunnel only: false. Internet-facing deployment requires HTTPS.
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_TRUST_PROXY=false
DJANGO_HSTS_SECONDS=0
POSTGRES_DB=safspp
POSTGRES_USER=safspp
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# closed | invite | open. closed is the safe default.
REGISTRATION_MODE=closed
# SHA-256 of a long random invitation code. Never put the raw code in this file/repo.
REGISTRATION_INVITE_SHA256=
# disabled | test | live. test accepts synthetic data only and labels all cases.
PORTAL_INTAKE_MODE=disabled
PORTAL_OPERATOR_NAME=
PORTAL_POLICY_VERSION=
PORTAL_POLICY_URL=
PUBLIC_SITE_URL=https://vsvld778.github.io/safspp-website/
# Email is not used for verification/reset until a separately reviewed flow is enabled.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
